# Copy this file to .env and fill in your values.
# The server works out of the box without a .env file (SQLite, no auth, stdio).

# ── Database backend ───────────────────────────────────────────────────────
# sqlite (default) or postgres
DB_BACKEND=sqlite

# Path to the SQLite database file.
# Leave blank to use the default: implementation/lab.db
SQLITE_PATH=

# PostgreSQL connection string (only needed when DB_BACKEND=postgres)
# Example: postgresql://user:password@localhost:5432/labdb
POSTGRES_DSN=

# ── HTTP / SSE transport auth ──────────────────────────────────────────────
# Set any secret string to enable Bearer token auth on HTTP and SSE transports.
# Leave empty to run without auth (stdio mode is always unprotected).
MCP_API_KEY=

# ── Transport settings (only matter for --transport http or sse) ───────────
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000
